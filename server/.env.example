# BotFather'dan olingan token (faqat sizda turadi, foydalanuvchilarga berilmaydi)
BOT_TOKEN=

# Tokenlarni imzolash uchun maxfiy kalit.
# MUHIM: bir marta yaratilib, hech qachon o'zgartirilmaydi —
# o'zgartirsangiz barcha foydalanuvchilarning kalitlari yaroqsiz bo'lib qoladi.
# Yaratish: openssl rand -hex 32
SECRET_KEY=

# Render'da bu avtomatik aniqlanadi (RENDER_EXTERNAL_URL).
# Faqat boshqa joyda webhook ishlatmoqchi bo'lsangiz to'ldiring.
# PUBLIC_URL=

# Foydalanuvchiga ko'rsatiladigan npm paket nomi
AGENT_PACKAGE=pingo-agent

PORT=3000
